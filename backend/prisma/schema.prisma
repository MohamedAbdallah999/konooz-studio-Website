generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SyncStatus {
  pending
  synced
  conflict
}

model Item {
  id          String        @id @default(uuid()) @db.Uuid
  modelNumber String        @map("model_number")
  price       Decimal       @db.Decimal(12, 2)
  photoUrl    String?       @map("photo_url")
  material    String?
  deletedAt   DateTime?     @map("deleted_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  syncStatus  SyncStatus    @default(synced) @map("sync_status")
  variants    ItemVariant[]

  @@index([modelNumber])
  @@map("items")
}

model ItemVariant {
  id            String     @id @default(uuid()) @db.Uuid
  itemId        String     @map("item_id") @db.Uuid
  size          String
  color         String
  stockQuantity Int        @default(0) @map("stock_quantity")
  deletedAt     DateTime?  @map("deleted_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  syncStatus    SyncStatus @default(synced) @map("sync_status")
  item          Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  saleItems     SaleItem[]

  @@index([itemId, size, color])
  @@map("item_variants")
}

model ProductModel {
  id          String        @id @default(uuid()) @db.Uuid
  modelNumber String        @map("model_number")
  price       Decimal       @db.Decimal(12, 2)
  photoUrl    String?       @map("photo_url")
  material    String?
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  syncStatus  SyncStatus    @default(synced) @map("sync_status")
  colours     ModelColour[]

  @@index([modelNumber])
  @@index([isActive, updatedAt])
  @@map("models")
}

model ModelColour {
  id         String       @id @default(uuid()) @db.Uuid
  modelId    String       @map("model_id") @db.Uuid
  name       String
  isActive   Boolean      @default(true) @map("is_active")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  syncStatus SyncStatus   @default(synced) @map("sync_status")
  model      ProductModel @relation(fields: [modelId], references: [id], onDelete: Restrict)
  packs      Pack[]

  @@index([modelId, isActive])
  @@map("model_colours")
}

model Pack {
  id            String      @id @default(uuid()) @db.Uuid
  modelColourId String      @map("model_colour_id") @db.Uuid
  sizesPerPack  Int         @map("sizes_per_pack")
  stockQuantity Int         @default(0) @map("stock_quantity")
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  syncStatus    SyncStatus  @default(synced) @map("sync_status")
  modelColour   ModelColour @relation(fields: [modelColourId], references: [id], onDelete: Restrict)
  saleItems     SaleItem[]

  @@index([modelColourId, isActive])
  @@index([isActive, stockQuantity])
  @@map("packs")
}

model Sale {
  id          String     @id @default(uuid()) @db.Uuid
  totalAmount        Decimal    @map("total_amount") @db.Decimal(12, 2)
  customerName       String?    @map("customer_name")
  customerPhone      String?    @map("customer_phone")
  shopName           String?    @map("shop_name")
  customerAddress    String?    @map("customer_address")
  discountPercentage Decimal    @default(0) @map("discount_percentage") @db.Decimal(5, 2)
  depositAmount      Decimal    @default(0) @map("deposit_amount") @db.Decimal(12, 2)
  paidAmount         Decimal    @default(0) @map("paid_amount") @db.Decimal(12, 2)
  paidAt             DateTime?  @map("paid_at")
  deletedAt   DateTime?  @map("deleted_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  syncStatus  SyncStatus @default(synced) @map("sync_status")
  items       SaleItem[]

  @@map("sales")
}

model SaleItem {
  id                     String       @id @default(uuid()) @db.Uuid
  saleId                 String       @map("sale_id") @db.Uuid
  itemVariantId          String?      @map("item_variant_id") @db.Uuid
  quantity               Int?
  unitPriceAtSale        Decimal?     @map("unit_price_at_sale") @db.Decimal(12, 2)
  legacyModelIdAtSale    String?      @map("legacy_model_id_at_sale") @db.Uuid
  legacyModelNumberAtSale String?     @map("legacy_model_number_at_sale")
  legacyModelPriceAtSale Decimal?     @map("legacy_model_price_at_sale") @db.Decimal(12, 2)
  legacyColourNameAtSale String?      @map("legacy_colour_name_at_sale")
  legacySizeAtSale       String?      @map("legacy_size_at_sale")
  modelIdAtSale          String?      @map("model_id_at_sale") @db.Uuid
  modelNumberAtSale      String?      @map("model_number_at_sale")
  modelPriceAtSale       Decimal?     @map("model_price_at_sale") @db.Decimal(12, 2)
  colourIdAtSale         String?      @map("colour_id_at_sale") @db.Uuid
  colourNameAtSale       String?      @map("colour_name_at_sale")
  packId                 String?      @map("pack_id") @db.Uuid
  sizesPerPackAtSale     Int?         @map("sizes_per_pack_at_sale")
  packPriceAtSale        Decimal?     @map("pack_price_at_sale") @db.Decimal(12, 2)
  numberOfPacks          Int?         @map("number_of_packs")
  lineSubtotal           Decimal?     @map("line_subtotal") @db.Decimal(12, 2)
  discountAllocation     Decimal?     @map("discount_allocation") @db.Decimal(12, 2)
  finalLineTotal         Decimal?     @map("final_line_total") @db.Decimal(12, 2)
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")
  syncStatus             SyncStatus   @default(synced) @map("sync_status")
  sale                   Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  itemVariant            ItemVariant? @relation(fields: [itemVariantId], references: [id], onDelete: Restrict)
  pack                   Pack?        @relation(fields: [packId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([packId])
  @@map("sale_items")
}

model AdminUser {
  id               String   @id @default(uuid()) @db.Uuid
  username         String   @unique
  passwordHash     String   @map("password_hash")
  refreshTokenHash String?  @map("refresh_token_hash")
  createdAt        DateTime @default(now()) @map("created_at")
  refreshSessions  RefreshSession[]

  @@map("admin_user")
}

model RefreshSession {
  id String @id @db.Uuid
  adminId String @map("admin_id") @db.Uuid
  tokenHash String @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  @@index([adminId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model ConflictLog {
  id            String   @id @default(uuid()) @db.Uuid
  tableName     String   @map("table_name")
  recordId      String   @map("record_id") @db.Uuid
  clientPayload Json     @map("client_payload")
  serverPayload Json     @map("server_payload")
  resolution    String
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("conflict_logs")
}
